# Maintainer: vbasky <vbasky@users.noreply.github.com>

pkgname=hatch
pkgver=0.2.0
pkgrel=1
pkgdesc="Menu-bar app that writes its own widgets (system tray popover for macOS and KDE/Plasma)"
arch=('x86_64' 'aarch64')
url="https://github.com/vbasky/hatch"
license=('MIT')
depends=(
  'qt6-base'
  'qt6-webengine'
  'layer-shell-qt'
  'kwindowsystem'
)
makedepends=(
  'nodejs'
  'pnpm'
  'rust'
  'cargo'
  'gcc'
  'pkgconf'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/vbasky/hatch/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/hatch-$pkgver"
  pnpm install --frozen-lockfile
  node scripts/build.mjs
  node scripts/prepare-tauri-resources.mjs
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/hatch-$pkgver"
  install -Dm755 "src-tauri/target/release/hatch" "$pkgdir/usr/bin/hatch"
  install -Dm644 "assets/hatch-app-icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hatch.svg"
  install -Dm644 "assets/linux/hatch.desktop" "$pkgdir/usr/share/applications/hatch.desktop"
  install -d "$pkgdir/usr/share/hatch"
  cp -a src-tauri/resources/. "$pkgdir/usr/share/hatch/"
}
