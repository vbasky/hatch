{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hatch",
  "version": "0.1.24",
  "identifier": "com.hatch.app",
  "build": {
    "beforeDevCommand": "pnpm exec vite --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "node scripts/build.mjs && node scripts/prepare-tauri-resources.mjs",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/256x256.png",
      "../assets/hatch-app-icon.icns"
    ],
    "resources": ["resources/**/*"],
    "macOS": {
      "entitlements": "../assets/entitlements.mac.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "infoPlist": "../assets/info.mac.plist"
    }
  }
}
