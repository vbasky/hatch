{
  "name": "hatch",
  "version": "0.2.0",
  "description": "Menu-bar app that writes its own widgets",
  "author": "YOUR_NAME",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:reset": "node scripts/dev.mjs --reset",
    "build": "node scripts/build.mjs",
    "tauri": "tauri",
    "generate:contracts": "node scripts/generate-extension-dts.mjs",
    "package:mac": "rm -rf release && pnpm exec tauri build --bundles app --config src-tauri/tauri.dev.conf.json && node scripts/copy-tauri-app.mjs && node scripts/adhoc-sign-mac-app.mjs \"release/mac-universal/Hatch.app\"",
    "dist:mac": "pnpm package:mac && node scripts/create-dmg.mjs \"release/mac-universal/Hatch.app\"",
    "test": "vitest run tests",
    "test:e2e": "vitest run tests/e2e-*.test.ts",
    "test:e2e:grok-popover": "node scripts/e2e-grok-popover.mjs",
    "test:e2e:packaged-mac": "node scripts/e2e-packaged-mac-app.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/api": "2.11.1",
    "acpx": "0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "2.11.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "acp-mock": "1.1.0",
    "esbuild": "0.28.0",
    "jsdom": "29.1.1",
    "vite": "8.0.13",
    "vitest": "4.1.6",
    "yaml": "^2.9.0"
  }
}
